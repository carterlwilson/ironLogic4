PORT=3001
MONGODB_URI=mongodb://localhost:27017/ironlogic4

# Production MongoDB Connection (for data sync script)
# Get this from MongoDB Atlas -> Database -> Connect -> Drivers
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_PROD_URI=mongodb+srv://username:password@cluster.mongodb.net/ironlogic4

JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=90d
NODE_ENV=development

# SendGrid Email Configuration (for password reset and client invites)
SENDGRID_API_KEY=your-sendgrid-api-key-here
SENDGRID_VERIFIED_SENDER=noreply@yourdomain.com
CLIENT_URL=http://localhost:3000
MOBILE_APP_URL=http://localhost:3002

# ChatGPT MCP account linking (all fields required to enable /mcp).
# Generate separate random secrets in your hosting provider; never commit real values.
MCP_PUBLIC_ORIGIN=https://ironlogic-server.onrender.com
MCP_APPROVED_USER_ID=
# Comma-separated user IDs allowed to link. When set, overrides MCP_APPROVED_USER_ID.
# Leave this variable absent (not blank) to use the single-user fallback above.
# MCP_ALLOWED_USER_IDS=
MCP_OAUTH_SECRET=
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
# Copy the exact callback URL shown by ChatGPT for your connection.
MCP_OAUTH_REDIRECT_URI=
# Optional explicit browser Origin allowlist, comma separated.
MCP_ALLOWED_ORIGINS=https://chatgpt.com
